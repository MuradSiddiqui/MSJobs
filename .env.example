NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_MODEL_STRONG=openai/gpt-oss-120b

CRON_SECRET=replace-me-with-a-long-random-string
APP_URL=http://localhost:3000

# Comma-separated adapter names. Empty = all enabled adapters.
INGEST_SOURCES=
# Per-source kill switches (set to "0" to disable)
INGEST_ARBEITNOW=1
INGEST_GREENHOUSE=1
INGEST_ASHBY=1
INGEST_SMARTRECRUITERS=1
INGEST_PERSONIO=1
INGEST_RECRUITEE=1
INGEST_LEVER=0
INGEST_TEAMTAILOR=0
INGEST_BUNDESAGENTUR=0
